		static function each_callback_args(&$res, $conf, $hash){
			$args = false;
			$item = static::call('build_item', $conf);
			if ($item) {
				//$args = array_merge(array(&$res, $hash, $item), $conf);
				$args = array(&$res, $item, $conf, $hash);
			}
			return $args;
		}
