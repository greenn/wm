-   -   -   -

set() //возвращает объект set
        с переданными ддаными
        с соответсующими установками
    [eg web/test/web/php/set.php?a=3]
    [eg
        new set(true, $def, $opts); //Использование $useDynamic, значение по-умолчанию и данных для опций
        new set($def, $opts); //Использование значений по-умолчанию и данных для опций
        new set(opt1, val1, $opts1, $opts2, #set1, opt3, val3); //установка значение перечнем (имя, значение)+
        new set(#set); //q-td
    ]


is_set() //проверяет являются ли данные объектом set
not_set() //данные не являются объектом set

setArr()  //возвращает объект set, установленный одним array-параметром

-   -   -   -

# set

    __construct() //установка опций
        [eg
            new set(true, $def, $opts);
            new set($def, $opts);
            new set($opts);
        ]

    _ default  //опции по умолчанию
    setDefaults() //установить опции по умолчанию

    *_ useDynamic  //использовать ли динамически управляемые опции через get-параметры
    *_  dynamic   //динамические опции
    setDynamic() //установка значений динамических опций
    dynamicUpdate() //подбор значений динамических опций

    _ data //значения опций
    setData() //установка значений опций заменой предыдущий / [4l] replaceData
    hasSetOpt() //было ли установлено значение этой опции

    set() //установка опций через перечисление имя, значение
        //допускаются массивы опций

    _ options  //массив опций на данный момент
        //[rb * _]
    optionsUpdate() //пересборка опций, с учётом всех установленных данных
        //[rb * _]

    hasOpt() //проверка, есть ли данная опция

    getOpt() //прямое получение значения опции

    opt()  //возвращает значение опции, если она есть, или предложеные вариант в противном случае
        [def в противном случае = false]

    isOpt() // проверяе на соответствие значения существуюшей опции

    __get() //динамическое получение значение опции если она есть
    __set() //динамическая установка значения
    __call() //динамическая обработка проверки значений
        //[eg [походу так]$set->opt1_or(false); //0

-   -   -   -   usage


if (not_set($set)) {
    $set = set(
        'par', 1, //$hasPar ? $set : false,
        'replace', 2 //$hasPar ? func_get_arg(3) : $set
    );
}

