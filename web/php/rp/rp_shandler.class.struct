	),
	'css' => array(
		'dir' => ROOT.'/css',
		'uri-ctx' => true
	),
	'tpl' => array(
		'dir' => ROOT.'/tpl',
	),
	'data' => array(
		'dir' => ROOT.'/data',
	),
	'ctx' => array(
		'dir' => ROOT.'/data/ctx',
	),
));
