scheme()

# scheme
    //берёт декларацию схемы, наследует её свойства
        и даёт возможность использывать их в различных действиях
    2) даёт возможность активировать составляющие части в схеме
        api ~ scheme_api
        data ~ crud_json

-   -   -

    __construct()
                    :: устанавливает в себя схему
                    :: создаёт объект set для опций

                    а так же инициализирует спец-части (по второму аргументу)


    type
                    тип схемы,
                        пока явно не используется

    fields
                    поля для элемента
                        type
                            key
                            -string
                        is_required
                        names
                        -title

    w
                    данные для используемых названий и терминов

    sd
                    данные о способе хранения

    api
                    настройки api
                        или
                    проинициализированный объект scheme_api для доступа к данным


    set
                    различные опции
                        allowExtension  //позволяет включать в элемент, поля пришедшие с данными, но не описанные в fields
                            true

                        unique  //указывает, как поля уникальны, и не должны присутствовать в списке
                            false
                            true
                            'confirm' - создаёт действие подтверждения операции
                                [td]

    field_is()
        1) $fieldName
        2) $opt
                    проверяет активна ли опция $opt у поля $fieldName


    conf
                    входной конфиг схемы

    setConf()
                    установка декларации схемы,
                        прямое расширение своего объекта полями из схемы

    init
                    set-объект про-инициализированных объектов

    init()
                    функция инициализации спец-частей


    verify_new*()
    verify_upd*()

    verify()
                    сверяет данные с полями схемы
                        проверяет условия валидации
                            is_required

                        =
                            ok
                            errors
                                EDE0
                                EDV0
                                EDM0
                            _data
                            _fields

    verifyUnique()
                    проверяет условия уникальности
                        не присутствует ли такие-же данные в другие элементанх списка
                        =
                            ok
                            errors
                                EDU0
                            acts
                                ADU0


    verifyChanges()
                    проверяет произошли ли изменения у элемента


    getIdName()
                   получить имя id-поля
                   //обычно это 'id'

    setId()
                    установка значения поля id