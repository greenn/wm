# etag
    ^
    @: pepper  //добавляет инкремент в время всех etagов
        //есть перчик,
        //который позволяет разово, но точно обновить все! значения etag

	opt:()  //парсит и устонавливает опцию для заголовков
	    ^
	    autofile

	@: debug  //делает виде etag возможным для визуального сопоставления и отлаживания
	@: debug_timePattern  //вид etag для отладки
	    //'{y-m-d H:i:s[u]}';
	
	value_debug:()  //функция подмены значения etag для отлаживания
	    //{%s-%s-%s} - [domain, path, version]

	value:()  //формирование значения etag
	    //{%s-%s-%s} - hash[domain, path, version]

	basedOnFile:()  //формирование etag относительно времени последнего изменения предоставленного файла

	autofile:()  //функция формирования ответных заголовков по файлу, от которого строится значение etag

