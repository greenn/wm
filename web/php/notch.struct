<?#1.3.17

notch_time() //засечка времени в микросекундах //[by microtime(true)]
    //[eg] notch_time(true) //вернём значение последней засечки


notch() //возвращает разницу между моментом вызовом и предыдущей (или переданныой) засечкой

notch_sep() //строка-суффикс после вывода засечки через _notch()
    //[eg
        установка:
            notch_sep(0) - '' //ничего / пустая строка
            notch_sep(1) - \r\n
            notch_sep(2) - <br /> //[df]
            notch_sep('<div>--</div>') - своя
        вывод установленного значения:
            notch_sep()
    ]

_notch() //вывод засечки времени с пост-суффиксом [df '<br />']

notch_() //[херндлер засечек по id
    //хранение как [id] = [time, title, notch]
    //возвращает id очередной засечки
    [eg
        notch_(false, 'Заголовок') - [ak notch_start('Заголовок') = return $id]
        notch_($id) - [ak notch_out($id)]
        notch_(true) - [c вывод notch от последней засечки]
        notch_(null) - вернёт стек засечек
    ]

    [ eg
        $N = 5 * 1000;
        $n1 = notch_(false, "for $N times");
        for ($i = 0; $i <= $N; $i++) {}
        notch_($n1);
    ]

notch_start() //начало засечки
notch_end() //конец засечки и вывод
notch_out() //конец засечки