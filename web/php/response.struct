

response()

# responseData

    __construct()

    set()
                                установка опций
                                    w
                                    dataFile
                                    sessionName

    w
                                используемые словесные якоря
            item

        w()
                                получение слова с возможными модификаторами по якорю

        msgTpl*                 стек темплейтов для ошибок
            E
            ES0
            EG0
            EGS0
            EGS1
            EDE0
            EDV0
            EDM0
            EDU0

            ADU0

        msg_ctx*
                                вспомогательный объекто для хранение контекста для темплейтов ошибок

        msg()
                                получение текста ошибки по коду темплейтв и контекста

        msg_callback*()
                                колбек-функция для обработки инструкций в темлейтах-сообщений
                                    конструкции располагаются между %%
                                    w/item|r ~ означает использование слова с якорем item в родительском падеже
                                    x/1 ~ означает первое значение контекста

        acts*
                                стек действий

        act()
                                объявление нового действия

        flush_acts()
                                отдача накопленных действий
        setActs()
                                установка нескольких действий

        errorHandler*
                                использование внешнего обработчика ошибок
                                    в противном случае ошибки складируется в errors

        errors*
                                место хранения ошибок по умолчанию

        error()
                                объявление ошибки (указание кода и контекста)
        setErrors()
                                объявление нескольких ошибок

        error_get_slice*()
                                обработчик ошибок для метода dataPath в get_slice

        flush_errors()
                                отдача накопленных ошибок

        state()
                                возвращает текущее состояние crud-объекта
                                    или какую-то часть
                                    errors
                                    acts
                                    res

        state_ok()
                                сообщает о безналичии ошибок или действий


        res*
                                текущий результат действий с crud-объектом
                                ok - состояние резульата
                                'errors - вносят errors в crud-объект и удаляются из результата
                                'acts - вносят acts в crud-объект и удаляются из результата
                                _*** - внутрение данные резульата, очищаются с использованием res_filter:()

        empty_res
                                состояние пустого результата

        res()
                                комбайн по работе с текущим состоянием объекта
                                res() - возвращает весь объект целиком
                                res((stringable)$prop) - возвращает данные или null из результата
                                res((bool)$res) - установка значение {ok}
                                res((array)$res) - расширение результата данными res
                                res(null) - перевод результата в дефолтное значение {empty_res}

        res_()
                                специальный вызов функции res(),
                                    которая предворяет указаным префиксом внутрение данные результата
                                    [man]
                                        res_('префикс', $resOperation);
                                    [eg]
                                        $this->res_('verify', $res = $scheme->verify($data) ); //dx($res);
        res_filter:()
                                скрытие внутренних свойст из рез-объекта
